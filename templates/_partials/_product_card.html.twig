{# Carte produit réutilisée sur l'accueil, le catalogue et la fiche produit #}
<article class="product-card h-100">
    <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="product-card-media">
        {% if product.mainImage %}
            <img src="{{ asset('uploads/products/' ~ product.mainImage) }}" alt="{{ product.name }}" loading="lazy">
        {% else %}
            <span class="product-card-placeholder"><i class="bi bi-image"></i></span>
        {% endif %}
        {% if product.featured %}<span class="tag tag-featured">À la une</span>{% endif %}
    </a>
    <div class="product-card-body">
        {% if product.category %}<p class="product-card-category">{{ product.category.name }}</p>{% endif %}
        <h3 class="product-card-title">
            <a href="{{ path('app_product_show', {slug: product.slug}) }}">{{ product.name }}</a>
        </h3>
        <div class="product-card-footer">
            <span class="price">{{ product.price|price }}</span>
            {% if product.options is empty %}
                {% include '_partials/_add_to_cart.html.twig' with {product: product, compact: true} %}
            {% else %}
                {# Produit avec options (couleur, taille…) : le choix se fait sur la fiche produit #}
                <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="btn btn-sm btn-outline-ink">Choisir</a>
            {% endif %}
        </div>
    </div>
</article>
