{#
    Formulaire d'ajout au panier.
    - envoyé en AJAX par assets/cart.js (attribut data-cart-add)
    - fonctionne aussi sans JavaScript (redirection classique)
    compact = version courte pour les cartes produit
#}
{% set compact = compact|default(false) %}
<form action="{{ path('app_cart_add', {id: product.id}) }}" method="post" data-cart-add class="{{ compact ? 'add-to-cart-compact' : 'add-to-cart' }}">
    <input type="hidden" name="_token" value="{{ csrf_token('cart_add') }}">
    {% if product.options is not empty %}
        {% set uid = 'opt-' ~ product.id ~ (compact ? '-c' : '') %}
        <label for="{{ uid }}" class="{{ compact ? 'visually-hidden' : 'form-label fw-semibold' }}">{{ product.options.first.type }}</label>
        <select id="{{ uid }}" name="option" data-option-select class="form-select {{ compact ? 'form-select-sm' : '' }}" required>
            {% if not compact %}<option value="">Choisir…</option>{% endif %}
            {% for option in product.options %}
                {% set optionImage = product.imageFor(option) %}
                <option value="{{ option.id }}" {% if optionImage %}data-image="{{ asset('uploads/products/' ~ optionImage) }}"{% endif %}>{{ compact ? option.value : option.type ~ ' : ' ~ option.value }}</option>
            {% endfor %}
        </select>
    {% endif %}
    <button type="submit" class="btn btn-accent {{ compact ? 'btn-sm btn-icon' : 'btn-lg w-100 mt-3' }}" {% if compact %}aria-label="Ajouter {{ product.name }} au panier" title="Ajouter au panier"{% endif %}>
        <i class="bi bi-bag-plus"></i>{% if not compact %} Ajouter au panier{% endif %}
    </button>
</form>
