{# Mise en page commune des emails : styles en ligne, compatibles avec les clients mail #}
<!DOCTYPE html>
<html lang="fr">
<body style="margin:0;padding:0;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#1f2430;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6;padding:24px 0;">
        <tr><td align="center">
            <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:12px;overflow:hidden;">
                <tr><td style="background:#141821;padding:20px 28px;color:#ffffff;font-size:20px;font-weight:bold;">Innov<span style="color:#ff5a36;">Shop</span></td></tr>
                <tr><td style="padding:28px;">
                    {% block content %}{% endblock %}
                </td></tr>
                <tr><td style="padding:16px 28px;background:#f9fafb;color:#6b7280;font-size:12px;">InnovShop · Vous recevez cet email suite à une commande sur notre boutique.</td></tr>
            </table>
        </td></tr>
    </table>
</body>
</html>
