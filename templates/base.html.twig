<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Accueil{% endblock %} · InnovShop</title>
        <meta name="description" content="{% block meta_description %}InnovShop, la boutique des produits technologiques innovants.{% endblock %}">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2224%22 fill=%22%23141821%22/><text x=%2250%22 y=%2268%22 font-size=%2260%22 font-family=%22Arial%22 font-weight=%22700%22 fill=%22%23ff5a36%22 text-anchor=%22middle%22>i</text></svg>">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    {# data-turbo="false" : navigation classique, plus simple à suivre pour le panier AJAX #}
    <body data-turbo="false" class="d-flex flex-column min-vh-100">
        <header class="site-header sticky-top">
            <nav class="navbar navbar-expand-lg">
                <div class="container">
                    <a class="navbar-brand brand" href="{{ path('app_home') }}">
                        <span class="brand-mark">i</span>InnovShop
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Ouvrir le menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        {% set route = app.request.attributes.get('_route') %}
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link {{ route == 'app_home' ? 'active' }}" href="{{ path('app_home') }}">Accueil</a></li>
                            <li class="nav-item"><a class="nav-link {{ route starts with 'app_catalogue' or route == 'app_product_show' ? 'active' }}" href="{{ path('app_catalogue') }}">Catalogue</a></li>
                        </ul>

                        <form class="d-flex header-search me-lg-3 my-2 my-lg-0" action="{{ path('app_catalogue') }}" method="get" role="search">
                            <i class="bi bi-search"></i>
                            <input class="form-control" type="search" name="q" placeholder="Rechercher un produit" aria-label="Rechercher" value="{{ app.request.query.get('q') }}">
                        </form>

                        <ul class="navbar-nav align-items-lg-center gap-lg-1">
                            {% if app.user %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li class="nav-item"><a class="nav-link" href="{{ path('admin') }}"><i class="bi bi-speedometer2"></i> Admin</a></li>
                                {% endif %}
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle"></i> {{ app.user.firstName }}
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        {% block account_menu %}
                                            <li><a class="dropdown-item" href="{{ path('app_account') }}">Mon compte</a></li>
                                            <li><a class="dropdown-item" href="{{ path('app_account_orders') }}">Mes commandes</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                        {% endblock %}
                                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                                    </ul>
                                </li>
                            {% else %}
                                <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Connexion</a></li>
                                <li class="nav-item"><a class="btn btn-sm btn-outline-ink ms-lg-1" href="{{ path('app_register') }}">Créer un compte</a></li>
                            {% endif %}
                            <li class="nav-item">
                                <a class="nav-link cart-link" href="{{ path('app_cart') }}" aria-label="Panier">
                                    <i class="bi bi-bag"></i>
                                    <span class="cart-badge" data-cart-count>{{ cart_count() }}</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            {# Bandeau d'information : reste visible avec le menu (header sticky) #}
            <div class="promo-bar">
                <div class="container">
                    <span><i class="bi bi-truck"></i> Livraison offerte dès 50 €</span>
                    <span class="d-none d-md-inline"><i class="bi bi-clock"></i> Expédié sous 48 h</span>
                    <span class="d-none d-md-inline"><i class="bi bi-arrow-repeat"></i> Retours gratuits sous 30 jours</span>
                </div>
            </div>
        </header>

        <main class="flex-grow-1">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="container mt-3">
                        <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer mt-5">
            <div class="container py-5">
                <div class="row g-4">
                    <div class="col-md-5">
                        <a class="brand text-white text-decoration-none" href="{{ path('app_home') }}"><span class="brand-mark">i</span>InnovShop</a>
                        <p class="mt-3 mb-0 text-white-50">Les produits technologiques qui simplifient le quotidien, sélectionnés et testés par notre équipe.</p>
                    </div>
                    <div class="col-6 col-md-3">
                        <h2 class="footer-title">Boutique</h2>
                        <ul class="list-unstyled">
                            <li><a href="{{ path('app_catalogue') }}">Catalogue</a></li>
                            <li><a href="{{ path('app_cart') }}">Panier</a></li>
                        </ul>
                    </div>
                    <div class="col-6 col-md-4">
                        <h2 class="footer-title">Mon compte</h2>
                        <ul class="list-unstyled">
                            {% if app.user %}
                                <li><a href="{{ path('app_account') }}">Tableau de bord</a></li>
                                <li><a href="{{ path('app_account_orders') }}">Mes commandes</a></li>
                            {% else %}
                                <li><a href="{{ path('app_login') }}">Connexion</a></li>
                                <li><a href="{{ path('app_register') }}">Créer un compte</a></li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
                <p class="small text-white-50 mt-4 mb-0">© {{ 'now'|date('Y') }} InnovShop · Projet de formation Symfony</p>
            </div>
        </footer>

        {# Notification affichée après un ajout au panier (voir assets/cart.js) #}
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div id="cart-toast" class="toast align-items-center border-0" role="status" aria-live="polite" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body" data-toast-message></div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Fermer"></button>
                </div>
            </div>
        </div>
    </body>
</html>
