{% extends 'account/_layout.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block account_content %}
    <h1 class="page-title">Profil et adresse</h1>
    <div class="panel">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            <div class="row">
                <div class="col-sm-6">{{ form_row(form.firstName) }}</div>
                <div class="col-sm-6">{{ form_row(form.lastName) }}</div>
            </div>
            {{ form_row(form.phone) }}
            {{ form_row(form.address) }}
            <div class="row">
                <div class="col-sm-4">{{ form_row(form.postalCode) }}</div>
                <div class="col-sm-8">{{ form_row(form.city) }}</div>
            </div>
            <hr>
            {{ form_row(form.monthlySpendingGoal) }}
            <button type="submit" class="btn btn-accent">Enregistrer</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
