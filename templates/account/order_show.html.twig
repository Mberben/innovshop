{% extends 'account/_layout.html.twig' %}

{% block title %}Commande {{ order.reference }}{% endblock %}

{% block account_content %}
    <a href="{{ path('app_account_orders') }}" class="small"><i class="bi bi-arrow-left"></i> Mes commandes</a>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 mb-3">
        <h1 class="page-title mb-0">Commande {{ order.reference }}</h1>
        <a href="{{ path('app_account_invoice', {reference: order.reference}) }}" class="btn btn-outline-ink"><i class="bi bi-file-earmark-pdf"></i> Télécharger la facture</a>
    </div>
    <p class="text-muted">Passée le {{ order.createdAt|date('d/m/Y à H:i') }}</p>

    {# Indicateur visuel de suivi #}
    <div class="panel mb-4">
        {% if order.status.value == 'cancelled' %}
            <p class="mb-0">{% include 'account/_status_badge.html.twig' with {status: order.status} %} Cette commande a été annulée.</p>
        {% else %}
            {% set currentIndex = 0 %}
            {% for s in steps %}{% if s == order.status %}{% set currentIndex = loop.index0 %}{% endif %}{% endfor %}
            <ol class="tracking">
                {% for s in steps %}
                    <li class="{{ loop.index0 < currentIndex ? 'done' : (loop.index0 == currentIndex ? 'current' : '') }}">
                        <span class="tracking-dot">{% if loop.index0 <= currentIndex %}<i class="bi bi-check-lg"></i>{% endif %}</span>
                        {{ s.label }}
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="panel">
                <h2 class="h5">Articles</h2>
                <table class="table align-middle mb-0">
                    <thead><tr><th>Produit</th><th>Option</th><th class="text-end">Prix</th></tr></thead>
                    <tbody>
                        {% for line in order.orderLines %}
                            <tr>
                                <td>{% if line.product %}<a href="{{ path('app_product_show', {slug: line.product.slug}) }}">{{ line.productName }}</a>{% else %}{{ line.productName }}{% endif %}</td>
                                <td class="text-muted">{{ line.optionLabel ?: '—' }}</td>
                                <td class="text-end tabular">{{ line.price|price }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot><tr><th colspan="2">Total TTC</th><th class="text-end tabular">{{ order.total|price }}</th></tr></tfoot>
                </table>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel">
                <h2 class="h5">Livraison</h2>
                <address class="mb-0">
                    <strong>{{ order.shippingName }}</strong><br>
                    {{ order.shippingAddress }}<br>
                    {{ order.shippingPostalCode }} {{ order.shippingCity }}<br>
                    <span class="text-muted">{{ order.shippingPhone }}</span>
                </address>
            </div>
        </div>
    </div>
{% endblock %}
