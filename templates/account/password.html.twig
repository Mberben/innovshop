{% extends 'account/_layout.html.twig' %}

{% block title %}Mot de passe{% endblock %}

{% block account_content %}
    <h1 class="page-title">Changer mon mot de passe</h1>
    <div class="panel" style="max-width: 32rem">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {{ form_row(form.currentPassword) }}
            {{ form_row(form.newPassword) }}
            <button type="submit" class="btn btn-accent">Modifier le mot de passe</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
